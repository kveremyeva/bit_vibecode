# Скопируйте в .env (ключ заполнит десктоп-приложение автоматически).
BITRIX_API_KEY=
BITRIX_API_BASE_URL=https://vibecode.bitrix24.tech/v1
BITRIX_PORTAL_DOMAIN=

# OAuth-флоу (вариант А). Адрес приложения, к которому VibeCode будет
# возвращать пользователя после входа, например:
# https://app-c5e09830ffb3.vibecode.bitrix24.tech
# В настройках приложения в VibeCode должен быть зарегистрирован
# redirect_uri: <APP_URL>/oauth/callback (совпадение scheme/host/port/path).
APP_URL=

# OAuth: Client ID Connect-приложения (публичный, без секрета) из раздела
# «Connect-приложения» Битрикс24, например vibe_partner_9ZK5c2Z0cPXH5YAz.
VIBE_CLIENT_ID=

# Права, запрашиваемые при входе (по умолчанию только то, что нужно дашборду).
OAUTH_SCOPE=crm,user
